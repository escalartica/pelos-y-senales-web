# URL pública del sitio (metadatos, sitemap y enlaces de los correos)
NEXT_PUBLIC_SITE_URL=https://pelosysenales.es

# Correo. Sin RESEND_API_KEY todo funciona en modo simulación (se registra en consola).
RESEND_API_KEY=
MAIL_FROM="Pelos y Señales <avisos@pelosysenales.es>"
# Buzón del equipo: recibe todas las consultas y las altas de alertas
CONSULTAS_TO=infopelosysenales@gmail.com
# Poner a "true" solo cuando las direcciones de las protectoras en lib/data.ts sean reales y hayan dado su acuerdo
SEND_TO_PROTECTORAS=false

# Opcional: webhook (Make, Zapier, Apps Script → Google Sheets) para registrar consultas y altas
CONSULTAS_WEBHOOK_URL=

# Clave para firmar enlaces (alertas, avisos, bajas). OBLIGATORIA en producción: 32+ caracteres aleatorios
ALERTAS_SECRET=

# Modo privado: si SITE_PASSWORD tiene valor, toda la web pide usuario y contraseña y no se indexa.
# Borrarlo (y volver a desplegar) el día que la web sea pública.
SITE_USER=equipo
SITE_PASSWORD=

# Base de datos de perdidos, avistados y avisos por zona (Upstash for Redis desde Vercel → Storage).
# Sin estas dos variables, en producción no se pueden publicar avisos.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Panel de administración (/admin): contraseña del equipo, mínimo 10 caracteres
ADMIN_PASSWORD=
